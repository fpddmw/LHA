*.webm export-ignore
*.mkv export-ignore
*.avi export-ignore
*.jpg export-ignore
*.jpeg export-ignore
*.png export-ignore
*.webp export-ignore
*.gif export-ignore
*.wav export-ignore
*.mp3 export-ignore
*.safetensors export-ignore
*.ckpt export-ignore
out export-ignore
