{
  "schema": "creative-experience-catalog-v1",
  "revision": "20261101-full-maintenance-draft",
  "entries": [
    {
      "id": "EX-design-conflict",
      "title": "A design can conceal the evidence that makes an activity readable",
      "path": "knowledge/staged/experience-full-maintenance-20261101/entries/design-conflict.md",
      "version": 2,
      "sha256": "35efa21875f98a1e46e00fa887d7d74bc47bc3115299f1ad251bc16c6190747a",
      "summary": "A successful costume, prop or lighting design can undermine the original activity by covering its support and contact relations. Repeating the preservation request leaves that design conflict in place.",
      "questions": [
        "Why did a visually successful addition make the action unreadable?"
      ],
      "renderers": [
        "bernini"
      ],
      "evidence_ids": [
        "EV-B-003",
        "EV-F003",
        "EV-F001"
      ],
      "review_status": "draft",
      "review_reference": "pending_user_content_review"
    },
    {
      "id": "EX-activity-relations",
      "title": "A coherent genre can reorganize who does what",
      "path": "knowledge/staged/experience-full-maintenance-20261101/entries/activity-relations.md",
      "version": 1,
      "sha256": "7b0c154f1ab1c6484e35a8deaac0dae51802751d12f9fa93e192b21ae48a56a3",
      "summary": "A video can retain the right people and objects while changing the activity. Genre-compatible staging can replace the particular relationships that made the source event intelligible.",
      "questions": [
        "Why do the right people and objects still perform a different event?"
      ],
      "renderers": [
        "bernini"
      ],
      "evidence_ids": [
        "EV-F003",
        "EV-F005",
        "EV-F001",
        "EV-visual-inspection"
      ],
      "review_status": "draft",
      "review_reference": "pending_user_content_review"
    },
    {
      "id": "EX-instance-identity",
      "title": "Appearance categories do not establish correspondence to an individual",
      "path": "knowledge/staged/experience-full-maintenance-20261101/entries/instance-identity.md",
      "version": 2,
      "sha256": "29db333850e2a74454562b30b6a8787fd56759d7546f2b065252163691064492",
      "summary": "An appearance description can faithfully specify a type of person while failing to retain this person. More identity adjectives add attributes; they do not add a correspondence constraint between source and output.",
      "questions": [
        "Why did more accurate person descriptions fail to preserve identity?"
      ],
      "renderers": [
        "bernini",
        "ditto"
      ],
      "evidence_ids": [
        "EV-D-FS4-no",
        "EV-D-FS4-full",
        "EV-F002",
        "EV-F003",
        "EV-F004",
        "EV-F005",
        "EV-F006",
        "EV-visual-inspection"
      ],
      "review_status": "draft",
      "review_reference": "pending_user_content_review"
    },
    {
      "id": "EX-object-continuity",
      "title": "A moving prop must remain the same participant across interaction states",
      "path": "knowledge/staged/experience-full-maintenance-20261101/entries/object-continuity.md",
      "version": 1,
      "sha256": "d586a4c6f288fd51d32185fe8fce70ae897f17690c36d8bbccd649473966b71f",
      "summary": "A prop can be recognizable in every local view while failing to be one continuous object in the action. Counting nouns in the prompt does not establish continuity of possession, visibility and release.",
      "questions": [
        "Why did a correctly named object multiply during an action?"
      ],
      "renderers": [
        "bernini"
      ],
      "evidence_ids": [
        "EV-F001",
        "EV-F006"
      ],
      "review_status": "draft",
      "review_reference": "pending_user_content_review"
    },
    {
      "id": "EX-connected-scope",
      "title": "Revision scope follows visual dependencies",
      "path": "knowledge/staged/experience-full-maintenance-20261101/entries/connected-scope.md",
      "version": 2,
      "sha256": "43a6138d6ff31f7f18314c4538e3672e239f6f4fb597f3d2fa64a13bb6d79663",
      "summary": "A revision's scope is determined by the visual relationships it changes. Calling it small supplies no spatial control; grouping everything under one background label does not make those changes coherent.",
      "questions": [
        "What does a focused revision actually need to change?"
      ],
      "renderers": [
        "bernini"
      ],
      "evidence_ids": [
        "EV-B-FS4-full",
        "EV-F006",
        "EV-F007",
        "EV-F004"
      ],
      "review_status": "draft",
      "review_reference": "pending_user_content_review"
    },
    {
      "id": "EX-input-conditioning",
      "title": "Choose an input for the information the proposed change needs",
      "path": "knowledge/staged/experience-full-maintenance-20261101/entries/input-conditioning.md",
      "version": 2,
      "sha256": "f2de1300db73ae5e62bde799bba50b9da8bccf0be3d531c6a93a7f98b1252302",
      "summary": "An input supplies achievements and losses together. A candidate's useful appearance can support continuation, while a source restart restores original evidence and requires the appearance to be generated again. The proposed change determines which information matters.",
      "questions": [
        "Which source or candidate supplies what the next proposal needs?"
      ],
      "renderers": [
        "bernini",
        "ditto"
      ],
      "evidence_ids": [
        "EV-batch-facts",
        "EV-F002",
        "EV-F003",
        "EV-F004",
