      ]
    },
    {
      "id": "EX-instance-identity",
      "path": "knowledge/staged/experience-curation-20261101/entries/instance-identity.md",
      "title": "Category description and individual identity",
      "version": "1",
      "sha256": "4b93fcc9de06484eb590f6e22f56a264035a2cfee23c4c9102b1e9fbad598f9e",
      "review_status": "draft",
      "review_reference": "Pending user content review",
      "summary": "More identity adjectives can add reconstruction instructions without establishing correspondence to the source person.** Age, hair and glasses describe categories of appearance. The desired preservation concerns a particular individual across the transformation.",
      "questions": [
        "identity preservation",
        "accessory reconstruction"
      ],
      "renderers": [
        "bernini",
        "ditto"
      ],
      "evidence_ids": [
