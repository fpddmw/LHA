    {
      "id": "EX-design-conflict",
      "path": "knowledge/staged/experience-curation-20261101/entries/design-conflict.md",
      "title": "Authored designs and activity readability",
      "version": "1",
      "sha256": "3a0261c098f37b16de2119c728f6d85a40f87fc1af10f44808e92eba1e3d6454",
      "review_status": "draft",
      "review_reference": "Pending user content review",
      "summary": "A preservation failure can originate in the visual proposal itself.** A costume, light effect or prop may be visually successful while covering the relationships that make the original activity intelligible. Repeating the preservation instruction leaves that conflict in place.",
      "questions": [
        "authored addition",
        "activity readability"
      ],
