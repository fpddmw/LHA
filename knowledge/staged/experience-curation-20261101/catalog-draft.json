    {
      "id": "EX-connected-scope",
      "path": "knowledge/staged/experience-curation-20261101/entries/connected-scope.md",
      "title": "Coherent visual scope without a spatial mask",
      "version": "1",
      "sha256": "4f0a206ffc80004b68a891610417a182807c49fe19aba7036b71a2b643ea3384",
      "review_status": "draft",
      "review_reference": "Pending user content review",
      "summary": "Calling a revision small does not constrain which pixels the renderer changes.** The interface provides a video and a text prompt, with no mask or invariant region. The proposal's actual visual dependencies provide a more useful way to understand its scope.",
      "questions": [
        "focused revision",
        "visual dependency"
      ],
      "renderers": [
        "bernini"
      ],
      "evidence_ids": [
        "B-FS4-full"
      ]
    },
    {
      "id": "EX-input-conditioning",
      "path": "knowledge/staged/experience-curation-20261101/entries/input-conditioning.md",
      "title": "Input as useful appearance and original information",
      "version": "1",
      "sha256": "70854ecaec24114f34da2ff246d7e40aafb75be35818958e310032755ffd9ad4",
      "review_status": "draft",
      "review_reference": "Pending user content review",
      "summary": "An editing input supplies both useful achievements and existing losses.** Source input carries original identity, structure and motion evidence. A candidate can carry a partially realized visual direction that the source lacks. The relevant question is which of those conditions the proposed change needs.",
      "questions": [
        "input selection",
        "inherited loss"
      ],
      "renderers": [
        "bernini",
        "ditto"
      ],
