  "entries": [
    {
      "id": "EX-design-conflict",
      "title": "Change the design that hides the action",
      "path": "knowledge/experience/curated/entries/design-conflict.md",
      "version": "3",
      "sha256": "93ece171472df08de35914390bb1e43751cb1ea117e7e1d877fc691d0e7c43ac",
      "summary": "When a design hides the contacts that make the action readable, reshape or relocate that design before adding preservation clauses. Realize user-required features around the action.",
      "questions": [
        "Why did a visually successful addition make the action unreadable?"
      ],
      "renderers": [
        "bernini"
      ],
      "evidence_ids": [
        "EV-B-003",
        "EV-F003",
        "EV-F001"
      ],
      "review_status": "approved",
      "review_reference": "docs/creative-fewshot-three-arm-plan.md#experimental-contract"
    },
    {
      "id": "EX-activity-relations",
      "title": "Give the new style a place without reassigning the activity",
      "path": "knowledge/experience/curated/entries/activity-relations.md",
      "version": "2",
      "sha256": "3c1af6284941201fff34553fb822cb8b572c53f1eb22a40262ed8c01a177fab4",
      "summary": "When retaining an event under a new genre, anchor who acts on whom and give the genre concrete visual scope. A preserved object inventory can still permit the wrong activity.",
      "questions": [
        "Why do the right people and objects still perform a different event?"
      ],
      "renderers": [
        "bernini"
      ],
      "evidence_ids": [
        "EV-F003",
        "EV-F005",
        "EV-F001",
        "EV-visual-inspection"
      ],
      "review_status": "approved",
      "review_reference": "docs/creative-fewshot-three-arm-plan.md#experimental-contract"
    },
    {
      "id": "EX-instance-identity",
      "title": "Protect the individual by reducing competing reconstruction",
      "path": "knowledge/experience/curated/entries/instance-identity.md",
      "version": "3",
      "sha256": "4a7b2b76cbdf9c51526b6034b7b0137e92a36cd9b42e265554b42ea670528a9b",
      "summary": "For identity-sensitive edits, favor an input with the right individual and reduce competing reconstruction around the person. Keep identity wording concise while preserving explicit costume requirements.",
      "questions": [
        "Why did more accurate person descriptions fail to preserve identity?"
      ],
      "renderers": [
        "bernini",
        "ditto"
      ],
      "evidence_ids": [
        "EV-D-FS4-no",
        "EV-D-FS4-full",
        "EV-F002",
