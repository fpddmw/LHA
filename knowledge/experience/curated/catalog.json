      "path": "knowledge/experience/curated/entries/time-binding.md",
      "version": "2",
      "sha256": "0a3a0de895a8bab923322eb2d008f0b489cc667229d89cd5eab71fdfd3769702",
      "summary": "Inspect the turns, occlusions and interactions that can undo an attractive opening. Favor delivery for incidental drift; give timing further attention when it carries the requested event.",
