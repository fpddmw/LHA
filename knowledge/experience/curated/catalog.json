    {
      "id": "EX-style-realization",
      "title": "Choose a visible system that makes the style legible",
      "path": "knowledge/experience/curated/entries/style-realization.md",
      "version": "2",
      "sha256": "2048ed005c2cbf452c692793e762e5b9805d816c21d3000d2ff569d94ac9d3c0",
      "summary": "Choose a coherent visible system for broad style requests. For detailed requests, check required construction separately from convincing ornament and atmosphere.",
      "questions": [
        "What does style knowledge add beyond a genre label?"
      ],
