    {
      "id": "EX-realization-change",
      "title": "Change the failed proposition, not just its emphasis",
      "path": "knowledge/experience/curated/entries/realization-change.md",
      "version": "2",
      "sha256": "b7bd7615be8c7948b9d624d6a731344877d9acd6674ff68ac3cbe297a5a8df4a",
      "summary": "After repeated explicit failure, prioritize changed realization or conditioning over stronger synonyms. Direct specification is more promising when the decisive relation was genuinely missing.",
      "questions": [
        "Did the proposed alternative actually change the failed operation?"
      ],
