    {
      "id": "EX-part-binding",
      "title": "Bind the effect to the intended part and distinguish its neighbor",
      "path": "knowledge/experience/curated/entries/part-binding.md",
      "version": "2",
      "sha256": "2bb33e27e2d8b0b858157851191d9ed3acb77fa414b9f3a8f9c57e02b964865a",
      "summary": "For an effect on the wrong part, describe the intended carrier in contrast to its neighbor. Anchor shape repair to the existing instance; consider an earlier intact input when duplication appears.",
      "questions": [
        "Why did the correct effect appear on the wrong part?"
      ],
