        "EV-visual-inspection"
      ],
      "review_status": "approved",
      "review_reference": "docs/creative-fewshot-three-arm-plan.md#experimental-contract"
    },
    {
      "id": "EX-object-continuity",
      "title": "Preserve a moving prop's role across state changes",
      "path": "knowledge/experience/curated/entries/object-continuity.md",
      "version": "2",
      "sha256": "4a0ce150162bdc57b0f2467cd9471af994e44cbaa9b034e08d5440f6f7980b6d",
      "summary": "For existing motion, favor concise source-linked object roles over unnecessary choreography. Inspect retrieval, occlusion and release before responding to duplication with more repetitions of one.",
      "questions": [
        "Why did a correctly named object multiply during an action?"
      ],
      "renderers": [
        "bernini"
      ],
      "evidence_ids": [
        "EV-F001",
        "EV-F006"
      ],
      "review_status": "approved",
      "review_reference": "docs/creative-fewshot-three-arm-plan.md#experimental-contract"
    },
    {
      "id": "EX-connected-scope",
      "title": "Revise a coherent visual field",
      "path": "knowledge/experience/curated/entries/connected-scope.md",
      "version": "3",
      "sha256": "fcbda798561052e1d35e1cea3c6738d1adec422dad8b18dfbd7a5b742a01714e",
      "summary": "Group changes by visual dependency: a window, view and reflections can be one coherent edit. Separate unrelated repairs when they need different inputs or explanations.",
      "questions": [
        "What does a focused revision actually need to change?"
      ],
      "renderers": [
        "bernini"
      ],
      "evidence_ids": [
        "EV-B-FS4-full",
        "EV-F006",
        "EV-F007",
        "EV-F004"
      ],
      "review_status": "approved",
      "review_reference": "docs/creative-fewshot-three-arm-plan.md#experimental-contract"
    },
    {
      "id": "EX-input-conditioning",
      "title": "Select the input that supports the next transformation",
      "path": "knowledge/experience/curated/entries/input-conditioning.md",
      "version": "3",
      "sha256": "d03207abf9e82ec21471efe5cbcc4cadeb939af859dd576f2a5f13e3fcedd013",
      "summary": "Continue a useful candidate when the next transformation builds on its achievements. If a central relationship is lost, favor the source or an earlier intact candidate and reconsider the transformation.",
      "questions": [
        "Which source or candidate supplies what the next proposal needs?"
      ],
      "renderers": [
        "bernini",
        "ditto"
      ],
