    {
      "id": "EX-environment-replacement",
      "title": "Transform the structures that make the place recognizable",
      "path": "knowledge/experience/curated/entries/environment-replacement.md",
      "version": "2",
      "sha256": "fb17b974378fcf4b22a7d0642d08fb3c563c8bed8083273a076343604966f24b",
      "summary": "If theme cues appear but the old place persists, remap its defining surfaces, boundaries and sightlines. Reassess input and realization when that mapping was already explicit and failed.",
      "questions": [
        "Why does the scene have theme cues but remain the old place?"
      ],
