    {
      "id": "EX-wanted-state",
      "title": "Replace an unwanted effect with a coherent visual alternative",
      "path": "knowledge/experience/curated/entries/wanted-state.md",
      "version": "2",
      "sha256": "5f9915b03b2e4e5efe3ccab4bce21f7d63ae5a7bcca8e3030efb759562aa6352",
      "summary": "Lead correction with a positive visual replacement and resolve conflicts with the surrounding design. Use short exclusions to disambiguate that arrangement.",
      "questions": [
        "What visual state replaces the unwanted artifact?"
