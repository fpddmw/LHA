{
  "limits": {"llm": 2, "gpu": 1, "cpu": 2},
  "model": "gpt-6.1-sol",
  "reasoning_effort": "xhigh",
  "llm_timeout_seconds": 1800,
  "enable_final_evaluation": false,
  "decode_cache_bytes": 536870912,
  "renderer": {
    "backend": "bernini",
    "asset_manifest": "out/server-assets/bernini.json",
    "asset_manifest_sha256": "REPLACE_WITH_VERIFIED_MANIFEST_SHA256",
    "gpu_lock": "/tmp/lha-gpu-0",
    "generation": {
      "num_inference_steps": 40,
      "guidance_mode": "v2v_apg",
      "max_image_size": 848,
      "negative_prompt": "",
      "prompt_enhancer": false
    }
  }
}
